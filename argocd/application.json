{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {"name": "radar", "namespace": "argocd"},
  "spec": {
    "project": "default",
    "source": {
      "repoURL": "https://github.com/BeolLe/radar-project.git",
      "targetRevision": "main",
      "path": "k8s"
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "radar"
    },
    "syncPolicy": {}
  }
}
